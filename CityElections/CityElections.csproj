<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>9</LangVersion>
		<Configurations>Debug;Release</Configurations>
		<RootNamespace>CityElections</RootNamespace>
		<AssemblyName>CityElections</AssemblyName>
		<!-- Mod information used when publishing to Paradox Mods -->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
		<!-- The UI module is built by npm, not MSBuild -->
		<DefaultItemExcludes>$(DefaultItemExcludes);UI\**</DefaultItemExcludes>

		<!-- Set by the official modding toolchain (game Options > Modding) -->
		<CSIIToolPath>$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CSIIToolPath>
		<HasModToolchain Condition="'$(CSIIToolPath)' != '' And Exists('$(CSIIToolPath)\Mod.props')">true</HasModToolchain>
	</PropertyGroup>

	<!-- With the toolchain: the official build, Burst post-processing and deploy to the Mods folder -->
	<Import Project="$(CSIIToolPath)\Mod.props" Condition="'$(HasModToolchain)' == 'true'" />
	<Import Project="$(CSIIToolPath)\Mod.targets" Condition="'$(HasModToolchain)' == 'true'" />

	<!--
		Without the toolchain: compile-only against the game's own DLLs, so the code can be
		checked before the toolchain is installed. Nothing is deployed in this mode.
		Point GameManagedPath at your install in Local.props (see Local.props.example).
	-->
	<Import Project="Local.props" Condition="'$(HasModToolchain)' != 'true' And Exists('Local.props')" />
	<PropertyGroup Condition="'$(HasModToolchain)' != 'true'">
		<GameManagedPath Condition="'$(GameManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</GameManagedPath>
		<FrameworkPathOverride>$(GameManagedPath)</FrameworkPathOverride>
		<DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
		<AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
		<AssemblySearchPaths>$(GameManagedPath);$(AssemblySearchPaths)</AssemblySearchPaths>
	</PropertyGroup>
	<ItemGroup Condition="'$(HasModToolchain)' != 'true'">
		<Reference Include="mscorlib"><Private>false</Private></Reference>
		<Reference Include="netstandard"><Private>false</Private></Reference>
		<Reference Include="System"><Private>false</Private></Reference>
		<Reference Include="System.Core"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game"><Private>false</Private></Reference>
		<Reference Include="Colossal.Core"><Private>false</Private></Reference>
		<Reference Include="Colossal.Logging"><Private>false</Private></Reference>
		<Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
		<Reference Include="Colossal.Localization"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI"><Private>false</Private></Reference>
		<Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
		<Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
		<Reference Include="Unity.Burst"><Private>false</Private></Reference>
		<Reference Include="Unity.Collections"><Private>false</Private></Reference>
		<Reference Include="Unity.Entities"><Private>false</Private></Reference>
		<Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(HasModToolchain)' == 'true'">
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>
</Project>
